# Google Ads — one file is enough. Fill via `gads-agent init` or the Setup page.
# Do not set GOOGLE_ADS_CONFIGURATION_FILE_PATH unless you still use google-ads.yaml.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_USE_PROTO_PLUS=true

# Optional YAML fallback for existing installs
# GOOGLE_ADS_CONFIGURATION_FILE_PATH=./google-ads.yaml

# OpenRouter (chat / AI Assistant)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=http://localhost:8787
OPENROUTER_APP_NAME=Google Ads Optimizer

# DataForSEO keyword research — https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Analytics 4 (same OAuth; sign in again with Analytics scopes)
GA4_PROPERTY_ID=

# Optimization thresholds
OPT_LOOKBACK_DAYS=30
OPT_MIN_CLICKS=50
OPT_MIN_IMPRESSIONS=500
OPT_MAX_CPA=50.0
OPT_MIN_ROAS=2.0
OPT_MIN_CTR=0.01
OPT_WASTE_SPEND=20.0
